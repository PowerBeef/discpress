{
  "name": "discpress-tests",
  "private": true,
  "description": "UI tests and conversion benchmarks for Discpress (not part of the app).",
  "type": "module",
  "scripts": {
    "fixtures": "python3 fixtures/make_fixtures.py",
    "native": "../scripts/build-native.sh",
    "dev-page": "test -f ../build/chdman.wasm || python3 ../scripts/extract-build.py; python3 ../scripts/assemble.py ../build/discpress-dev.html",
    "test": "playwright test",
    "test:dev": "npm run dev-page && DISCPRESS_HTML=build/discpress-dev.html playwright test",
    "report": "playwright show-report .cache/report",
    "bench": "node bench/bench.js",
    "bench:dev": "npm run dev-page && node bench/bench.js --html ../build/discpress-dev.html"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1"
  }
}
