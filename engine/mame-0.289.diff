+static int chdman_start(int argc, char *argv[])
+{
+	s_run = std::make_unique<chdman_run>();
+	int const result = chdman_parse(argc, argv);
+	if (result != CHDMAN_PAUSED)
+		s_run.reset();
+	return result;
