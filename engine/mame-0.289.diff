+			toc.tracks[tracknum].pregap += curextra;
+			toc.tracks[tracknum].splitframes = curextra;
+			toc.tracks[tracknum].pgdatasize = toc.tracks[tracknum].datasize;
+			toc.tracks[tracknum].pgtype = toc.tracks[tracknum].trktype;
+		}
+	}
