+		if (keyword(line, at, "FILE"))
+		{
+			if (tracks > 0 && !check_gd_track(tracks - 1))
+				return std::string();
+			if ((file > 0 && file_tracks != 1) || file >= files.size())
+				return std::string();
+			size_t const name_start = at;
+			std::string name;
+			if (at < line.size() && line[at] == '"')
+			{
+				size_t const close = line.find('"', at + 1);
+				if (close == std::string::npos)
+					return std::string();
+				name = line.substr(at + 1, close - at - 1);
+				at = close + 1;
+			}
+			else
+			{
+				while (at < line.size() && !isspace(uint8_t(line[at])))
+					name += line[at++];
+			}
+			size_t type = at;
+			while (type < line.size() && isspace(uint8_t(line[type])))
+				type++;
+			if (!keyword(line, type, "BINARY") || type != line.size())
+				return std::string();
+			if (name != files[file])
+				line = line.substr(0, name_start) + "\"" + files[file] + "\"" + line.substr(at);
+			file++;
+			file_tracks = 0;
+		}
+		else if (keyword(line, at, "TRACK"))
+		{
+			if (tracks > 0 && !check_gd_track(tracks - 1))
+				return std::string();
+			// its number, then its type: the CHD's track's
+			while (at < line.size() && !isspace(uint8_t(line[at])))
+				at++;
+			while (at < line.size() && isspace(uint8_t(line[at])))
+				at++;
+			std::string type;
+			while (at < line.size() && !isspace(uint8_t(line[at])))
+				type += char(std::toupper(uint8_t(line[at++])));
+			if (type.compare(0, 4, "CDI/") == 0) // (a CD-i track: Mode 2, as chdman reads it)
+				type = "MODE2/" + type.substr(4);
+			if (tracks >= track_types.size() || type != track_types[tracks])
+				return std::string();
+			cur_pregap = 0;
+			cur_idx0 = -1;
+			cur_idx1 = -1;
+			file_tracks++;
+			tracks++;
+		}
+		else if (gd_toc && tracks > 0)
+		{
+			if (keyword(line, at, "PREGAP"))
+			{
+				int const frames = parse_msf(line, at);
+				if (frames < 0)
+					return std::string();
+				cur_pregap = frames;
+			}
+			else if (keyword(line, at, "INDEX"))
+			{
+				size_t num_end = at;
+				while (num_end < line.size() && !isspace(uint8_t(line[num_end])))
+					num_end++;
+				int const idx = atoi(line.substr(at, num_end - at).c_str());
+				at = num_end;
+				while (at < line.size() && isspace(uint8_t(line[at])))
+					at++;
+				int const frames = parse_msf(line, at);
+				if (frames < 0)
+					return std::string();
+				if (idx == 0)
+					cur_idx0 = frames;
+				else if (idx == 1)
+					cur_idx1 = frames;
+			}
+		}
+		out += line;
+		if (nl != std::string::npos)
+			out += '\n';
+	}
+	if (file != files.size() || file_tracks != 1 || tracks != track_filenames.size())
+		return std::string();
+	if (tracks > 0 && !check_gd_track(tracks - 1))
+		return std::string();
+	return out;
+}
