+extern "C" EMSCRIPTEN_KEEPALIVE int chdman_begin(int argc, char *argv[])
+{
+	int const result = chdman_start(argc, argv);
+	return (result == CHDMAN_PAUSED) ? chdman_continue() : result;
+}
