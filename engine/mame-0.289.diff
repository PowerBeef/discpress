+		if (type == CHD_CODEC_NONE)
+			continue;
+		all |= 1 << slot;
+		if ((type == CHD_CODEC_CD_FLAC) || (type == CHD_CODEC_FLAC))
+			flac |= 1 << slot;
+		if (type == CHD_CODEC_CD_LZMA)
+			cdlz |= 1 << slot;
+	}
