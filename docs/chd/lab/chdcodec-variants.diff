 #include <zlib.h>
 #include <zstd.h>
 
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include "libdeflate.h"
+#include "zopfli/zopfli.h"
+
+// ---- Discpress research variants (environment-controlled; defaults = stock MAME) ----
+namespace {
+// CHDV_DEFLATE = zlib (default) | libdeflate:<1-12> | zopfli:<iterations>
+long variant_deflate(const uint8_t *src, uint32_t srclen, uint8_t *dest, uint32_t destcap)
+{
+	static const char *mode = getenv("CHDV_DEFLATE");
+	if (!mode || !strncmp(mode, "zlib", 4)) return -1;
+	if (!strncmp(mode, "libdeflate:", 11))
+	{
+		static thread_local libdeflate_compressor *c = libdeflate_alloc_compressor(atoi(mode + 11));
+		size_t n = libdeflate_deflate_compress(c, src, srclen, dest, destcap);
+		return n ? long(n) : long(0x7fffffff);
+	}
+	if (!strncmp(mode, "zopfli:", 7))
+	{
+		ZopfliOptions o; ZopfliInitOptions(&o); o.numiterations = atoi(mode + 7);
+		unsigned char *out = nullptr; size_t outsize = 0;
+		ZopfliCompress(&o, ZOPFLI_FORMAT_DEFLATE, src, srclen, &out, &outsize);
+		long r = long(0x7fffffff);
+		if (outsize <= destcap) { memcpy(dest, out, outsize); r = long(outsize); }
+		free(out);
+		return r;
+	}
+	return -1;
+}
+}
